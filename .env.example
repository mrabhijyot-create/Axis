# Anthropic API — Claude Opus inference (optional, falls back to fixture)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-6

# OpenWeatherMap (optional, falls back to fixture)
OPENWEATHER_API_KEY=

# Live JSON feed for playing XI / toss (optional, falls back to fixture)
LIVE_FEED_URL=

# Telegram notifier — get a bot token from @BotFather, then DM the bot
# and grab your chat ID from https://api.telegram.org/bot<TOKEN>/getUpdates.
# Without these set, scripts/cron_tick.py prints the message instead of sending.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CricAPI (https://cricapi.com) — daily schedule refresh. Free tier is ~100
# calls/day; we use 2 calls per refresh, so once a day is well under quota.
CRICAPI_KEY=

# Local SQLite path (defaults to data/ipl.db)
IPL_DB_URL=sqlite:///data/ipl.db

# Polling cadence (seconds) during the warm-up window
LIVE_POLL_INTERVAL_SECONDS=30
